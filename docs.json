{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Bluprynt",
  "description": "Documentation for Bluprynt Passport, Bluprynt Proof, the KYI Widget SDK and the Bluprynt APIs.",
  "colors": {
    "primary": "#007BFF",
    "light": "#4DA3FF",
    "dark": "#0062CC"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://bluprynt.com"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "light"
  },
  "styling": {
    "codeblocks": "system"
  },
  "navbar": {
