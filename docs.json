{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Bluprynt",
  "description": "Documentation for Bluprynt Passport, Bluprynt Proof, the KYI Widget SDK and the Bluprynt APIs.",
  "colors": {
    "primary": "#007BFF",
    "light": "#4DA3FF",
    "dark": "#0062CC"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://bluprynt.com"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "light"
  },
  "styling": {
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Explorer",
        "href": "https://explorer.bluprynt.com"
      },
      {
        "label": "Support",
        "href": "mailto:product@bluprynt.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.bluprynt.com"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "concepts",
              "supported-chains"
            ]
          },
          {
            "group": "Bluprynt Passport",
            "pages": [
              "passport/overview",
              "passport/organization",
              "passport/verify-asset",
              "passport/proof-of-collateral",
              "passport/disclosures"
            ]
          },
          {
            "group": "Bluprynt Proof",
            "pages": [
              "proof/overview",
              "proof/applications",
              "proof/registry"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "tools/kyi",
              "tools/proof-of-collateral",
              "tools/asset-dependency-engine",
              "tools/disclosure-monitoring",
              "tools/compliance-explorer"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "support"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "icon": "code",
        "groups": [
          {
            "group": "KYI Widget SDK",
            "pages": [
              "sdk/overview",
              "sdk/quickstart",
              "sdk/flow",
              "sdk/tokens",
              "sdk/wallet-verification",
              "sdk/reference",
              "sdk/security",
              "sdk/errors",
              "sdk/example-explorer-claim",
              "sdk/faq"
            ]
          },
          {
            "group": "Public API",
            "openapi": "/openapi/public.json",
            "pages": [
              "api/public/overview",
              "api/public/badge-recipe",
              "GET /assets",
              "GET /assets/{chain}/{account_address}",
              "GET /assets/{namespace}/{reference}/{account_address}",
              "GET /api/v1/badges/{credential_type}"
            ]
          },
          {
            "group": "Explorer API",
            "openapi": "/openapi/explorer.json",
            "pages": [
              "api/explorer/overview",
              "GET /tokenomics/changes",
              "GET /assets/{id}/tokenomics/changes",
              "GET /me/watchlist",
              "POST /me/watchlist",
              "PATCH /me/watchlist/{id}",
              "DELETE /me/watchlist/{id}",
              "GET /me/monitoring/changes",
              "GET /me/notifications"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/blupryntco",
      "linkedin": "https://www.linkedin.com/company/the-bluprynt/"
    }
  }
}
